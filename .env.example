# ============================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# ============================================
# DATABASE
# ============================================
# For Neon.tech or production (with SSL), add sslmode=verify-full to avoid warnings:
# DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
DATABASE_URL=postgresql://user:password@localhost:5432/zalo_bot

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
# NODE_ENV=production  # Uncomment for production

# ============================================
# AUTHENTICATION (Simple fallback - deprecated)
# ============================================
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ============================================
# ADMIN USER CREATION (For automated deployment)
# ============================================
# Used by scripts/deploy-setup.sh and database/create-user-cli.ts
# Set these when deploying to production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=  # SET THIS! Min 8 characters
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Administrator

# ⚠️ SECURITY NOTES:
# 1. Use strong password (min 8 chars, mix of letters/numbers/symbols)
# 2. Delete ADMIN_PASSWORD after first login
# 3. Never commit .env to Git
# 4. Rotate passwords regularly

# ============================================
# REGISTRATION API (Optional - for production)
# ============================================
# Enable only temporarily to create first user, then disable immediately

REGISTRATION_ENABLED=false
REQUIRE_INVITE_CODE=true
INVITE_CODE=  # Set a secure random string

# ============================================
# GEMINI AI (for auto-reply feature)
# ============================================
GEMINI_API_KEY=  # Your Gemini API key (format: AQ.xxx or AIzaSy...)

# ============================================
# CLOUDINARY CDN (for media uploads)
# ============================================
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default

# ============================================
# VIETQR API (Optional - for bank account lookup)
# ============================================
# The app tries free API first. If you have VietQR API key, add here for better reliability
# Get your credentials at: https://vietqr.io or https://cas.so
# VIETQR_CLIENT_ID=your_client_id
# VIETQR_API_KEY=your_api_key

# ============================================
# PUSH NOTIFICATIONS (Optional)
# ============================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ============================================
# SERVER
# ============================================
PORT=3000
HOST=0.0.0.0

# ============================================
# DEPLOYMENT EXAMPLES
# ============================================

# Vercel:
# - Set all variables in Project Settings → Environment Variables
# - DATABASE_URL from Vercel Postgres or external provider

# Railway:
# - Set variables in Settings → Variables
# - Use ${{Postgres.DATABASE_URL}} for Railway Postgres

# Render:
# - Set variables in Environment → Environment Variables
# - Use Internal Database URL for Render Postgres

# VPS/Docker:
# - Copy this file to .env
# - Fill in all values
# - chmod 600 .env
